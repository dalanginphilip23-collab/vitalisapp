PORT=3000
# NODE_ENV=production enforces email verification before login. Any other value
# (development/test) AUTO-VERIFIES new accounts and skips the verification email,
# so you can sign up and log in with dummy addresses and no SMTP.
NODE_ENV=development
ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=root
DB_PASS=
DB_NAME=fitnessapp
JWT_SECRET=replace-with-random-64-hex-chars-min-32-not-the-example-value
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GEMINI_API_KEY=
GROQ_API_KEY=
# Optional model overrides (comma-separated, tried in order). Defaults try
# the verified working model first (gemini-3.6-flash), then newer fallbacks.
# GEMINI_TEXT_MODELS=gemini-3.6-flash,gemini-3.8-flash
# GEMINI_VISION_MODELS=gemini-3.6-flash,gemini-3.8-flash
# Keep DB + app on the same timezone (UTC recommended) — aiQuota UTC_DATE(),
# daily_stats stat_date, and readiness TODAY must agree on day boundaries.
# TZ=UTC
# ── Email / SMTP ─────────────────────────────────────────────────────────────
# Provider: BREVO (transactional SMTP relay). Get these from
# Brevo → SMTP & API → SMTP tab. Leave blank to disable email gracefully.
BREVO_SMTP_LOGIN=
BREVO_SMTP_KEY=
# Optional overrides (defaults shown)
# BREVO_SMTP_HOST=smtp-relay.brevo.com
# BREVO_SMTP_PORT=587
# From address/name shown to recipients (defaults: BREVO_SMTP_LOGIN / "Vitalis")
# MAIL_FROM=
MAIL_FROM_NAME=Vitalis
# Legacy Gmail fallback — only used if BREVO_* above are unset.
EMAIL_USER=
EMAIL_PASS=
# Inbox for public POST /api/feedback (rate-limited, no auth by design)
RECEIVER_EMAIL=
FRONTEND_URL=http://localhost:5173
# DANGER: =1 exposes verify/reset links in API responses. Never enable in production.
ALLOW_DEV_LINKS=0
# Set to 1 only for local dev behind a MITM proxy; never in production
# MAILER_INSECURE_TLS=0
# Scale tuning (same defaults as code — no behavior change unless set)
# DB_POOL_MAX=25
# DB_QUEUE_LIMIT=200
# GLOBAL_RATE_LIMIT=1000
# AI_DAILY_LIMIT=50
# Managed MySQL TLS (Aiven): TLS turns on automatically when NODE_ENV=production
# or DB_HOST ends in .aivencloud.com / .aiven.io. DB_SSL=1 forces it on anywhere,
# DB_SSL=0 forces it off. DB_SSL_CA takes a path to ca.pem or the raw PEM inline
# (how deploy secrets are injected); production fails fast if it is missing.
# DB_SSL=
# DB_SSL_CA=
# Regex allowlist for preview deployments (e.g. ^https:\/\/preview-.*\.example\.com$)
# ALLOWED_ORIGIN_REGEX=
# Dedicated salt for landing visit ip_hash (optional — falls back to JWT_SECRET slice for old hashes)
# IP_HASH_SALT=replace-with-random-32-char-string
# Socket auth re-verify interval in ms (see src/sockets/socketHandler.js)
# SOCKET_REVERIFY_MS=
# Verbose request logging (see src/middleware/requestLogger.js)
# DEBUG=0
