{
  "compilerOptions": {
    "baseUrl": ".",
    "checkJs": true,
    "allowJs": true,
    "module": "ESNext",
    "target": "ES2020",
    "moduleResolution": "bundler",
    "jsx": "react-jsx",
    "lib": ["ES2020", "DOM", "DOM.Iterable"],
    "types": ["vite/client", "node"],
    "resolveJsonModule": true,
    "strict": false,
    "paths": {
      "@/*": ["src/*"]
    }
  },
  "include": ["src", "vite.config.js", "eslint.config.js"],
  "exclude": ["node_modules", "dist"]
}
